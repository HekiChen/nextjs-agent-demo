{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "strict": true,
    "jsx": "preserve",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./app/components/*"],
      "@utils/*": ["./app/utils/*"]
    }
  },
  "include": ["app/**/*", "pages/**/*", "prisma/**/*", "next-env.d.ts"],
  "exclude": ["node_modules"]
}